{
  "expo": {
    "name": "Chronodrom",
    "slug": "chronodrom",
    "version": "1.0.0",
    "scheme": "chronodrom",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chronodrom.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.150562947459-mr8v6bn2bkmerq1b7cb2n72om2evk8jq"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Chronodrom reads your runs, heart rate and body data from Apple Health to build your run history. It never writes to Apple Health.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7bd49bdb-3dc2-4808-8b50-8612f455b0a1"
      }
    },
    "owner": "baranchel"
  }
}
