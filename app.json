{
  "expo": {
    "name": "Chronodrom",
    "slug": "chronodrom",
    "version": "1.0.0",
    "scheme": "chronodrom",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chronodrom.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ]
  }
}
